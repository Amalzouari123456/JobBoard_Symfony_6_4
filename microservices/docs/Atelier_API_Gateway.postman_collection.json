{
  "info": {
    "name": "Atelier API Gateway",
    "description": "Toutes les requetes passent par l'API Gateway (http://localhost:8085). Lancer d'abord Eureka, Candidat, Job et la Gateway. Executer les requetes dans l'ordre (le POST cree la ressource lue ensuite).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "gateway", "value": "http://localhost:8085" },
    { "key": "candidatId", "value": "1" },
    { "key": "jobId", "value": "1" }
  ],
  "item": [
    {
      "name": "Candidat",
      "item": [
        {
          "name": "Hello (instance qui repond)",
          "request": { "method": "GET", "url": "{{gateway}}/candidat/hello" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Statut 200', () => pm.response.to.have.status(200));",
            "pm.test('Reponse du service CANDIDAT', () => pm.expect(pm.response.text()).to.include('CANDIDAT'));"
          ] } }]
        },
        {
          "name": "Creer un candidat",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nom\": \"Zouari\",\n  \"prenom\": \"Amal\",\n  \"email\": \"amal.zouari@example.com\",\n  \"headline\": \"Developpeuse Java\"\n}" },
            "url": "{{gateway}}/candidat"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Statut 200', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "pm.test('Un id est genere', () => pm.expect(body.id).to.be.a('number'));",
            "pm.collectionVariables.set('candidatId', body.id);"
          ] } }]
        },
        {
          "name": "Lister les candidats",
          "request": { "method": "GET", "url": "{{gateway}}/candidat" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Statut 200', () => pm.response.to.have.status(200));",
            "pm.test('Reponse = tableau', () => pm.expect(pm.response.json()).to.be.an('array'));"
          ] } }]
        },
        {
          "name": "Candidat par ID",
          "request": { "method": "GET", "url": "{{gateway}}/candidat/{{candidatId}}" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Statut 200', () => pm.response.to.have.status(200));",
            "pm.test('Bon candidat', () => pm.expect(pm.response.json().email).to.eql('amal.zouari@example.com'));"
          ] } }]
        }
      ]
    },
    {
      "name": "Job",
      "item": [
        {
          "name": "Hello (instance qui repond)",
          "request": { "method": "GET", "url": "{{gateway}}/jobs/hello" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Statut 200', () => pm.response.to.have.status(200));",
            "pm.test('Reponse du service JOB', () => pm.expect(pm.response.text()).to.include('JOB'));"
          ] } }]
        },
        {
          "name": "Creer une offre",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Developpeur Spring Boot\",\n  \"description\": \"Microservices et Spring Cloud\",\n  \"contractType\": \"CDI\",\n  \"location\": \"Tunis\",\n  \"remote\": true,\n  \"published\": true,\n  \"companyName\": \"TalentConnect\"\n}" },
            "url": "{{gateway}}/jobs"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Statut 200', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "pm.test('Un id est genere', () => pm.expect(body.id).to.be.a('number'));",
            "pm.collectionVariables.set('jobId', body.id);"
          ] } }]
        },
        {
          "name": "Lister les offres",
          "request": { "method": "GET", "url": "{{gateway}}/jobs" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Statut 200', () => pm.response.to.have.status(200));",
            "pm.test('Reponse = tableau', () => pm.expect(pm.response.json()).to.be.an('array'));"
          ] } }]
        },
        {
          "name": "Offre par ID",
          "request": { "method": "GET", "url": "{{gateway}}/jobs/{{jobId}}" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Statut 200', () => pm.response.to.have.status(200));",
            "pm.test('Bonne offre', () => pm.expect(pm.response.json().companyName).to.eql('TalentConnect'));"
          ] } }]
        }
      ]
    }
  ]
}
